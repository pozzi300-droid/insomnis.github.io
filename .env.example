# Server & Networking
SERVER_PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Crypto Bot API (Crypto Pay) Integration
# Get API token in Telegram via @CryptoBot or @CryptoTestnetBot -> Crypto Pay -> Create App / API Token
CRYPTO_BOT_API_TOKEN="YOUR_CRYPTO_BOT_API_TOKEN"

# Set to "true" to use Crypto Bot Testnet (https://testnet-pay.crypt.bot/api)
CRYPTO_BOT_TESTNET="false"


